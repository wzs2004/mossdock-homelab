{
  "manifest_version": 3,
  "name": "Audiobookshelf · 当前书籍匹配",
  "version": "1.5.0",
  "description": "选择书籍匹配来源，展示全部候选并手动应用元数据",
  "permissions": [
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开匹配设置"
  },
  "host_permissions": [
    "https://books6.mossdock.autos/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
