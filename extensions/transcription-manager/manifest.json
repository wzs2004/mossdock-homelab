{
  "manifest_version": 3,
  "name": "Audiobookshelf · 转写管理",
  "version": "2.4.0",
  "description": "转写任务管理、清除文稿重新识别、SRT 搜索和手选章节",
  "permissions": [
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Audiobookshelf 全部任务中心"
  },
  "host_permissions": [
    "https://books6.mossdock.autos/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
