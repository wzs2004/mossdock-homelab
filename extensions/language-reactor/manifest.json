{
  "manifest_version": 3,
  "name": "Audiobookshelf → Language Reactor",
  "version": "1.5.0",
  "description": "Open audiobook tracks in Language Reactor with existing SRT captions.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.languagereactor.com/*"
      ],
      "js": [
        "language-reactor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://books6.mossdock.autos/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
