{
    auto_https off
    admin off
    servers {
        trusted_proxies static private_ranges
    }
}

# Audiobookshelf + 扩展专用接口
:{{accel_books}} {
    encode zstd gzip
    handle_path /__ext/meta/* {
        reverse_proxy meta-bridge:{{meta_port}} {
            header_up Host 127.0.0.1
        }
    }
    handle_path /__ext/lr/* {
        reverse_proxy abs-lr-bridge:{{lr_bridge_port}}
    }
    handle {
        @versioned path_regexp abs ^/audiobookshelf/_nuxt/[a-f0-9]+\.(js|css)$
        header @versioned >Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy audiobookshelf:80
    }
}

# Immich
:{{accel_photos}} {
    encode zstd gzip
    @versioned path /_app/immutable/*
    header @versioned >Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy immich-gate:2283
}
